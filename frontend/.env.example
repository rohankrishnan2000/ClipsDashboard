# ── Frontend environment ──────────────────────────────────────────────
# Copy to .env.local for local dev, and set the same vars in the Vercel
# project settings for production.

# Base URL of the FastAPI backend that the /api/* routes proxy to.
# Local dev: http://localhost:8000  (this is the default if unset in dev)
# Production (Vercel): set this to your deployed backend, e.g. the Vultr VPS
#   https://api.yourdomain.com
# If left blank in production, the app will not proxy API calls.
BACKEND_URL=http://localhost:8000
