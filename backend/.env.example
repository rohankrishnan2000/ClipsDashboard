# ── Backend environment (FastAPI clipping bot) ────────────────────────
# Copy to .env (in the repo root OR in backend/) and fill in. Everything
# below except OPENAI_API_KEY is optional groundwork you can wire up later.

# ── OpenAI (required for transcription + clip analysis) ───────────────
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_CLIP_MODEL=gpt-4.1-mini

# ── CORS / public URL ─────────────────────────────────────────────────
# Comma-separated extra origins allowed to call the API (your Vercel URL).
EXTRA_CORS_ORIGINS=https://your-app.vercel.app
# Public https URL of THIS backend. Needed so TikTok can pull clips by URL
# when using local storage. e.g. https://api.yourdomain.com
PUBLIC_BASE_URL=

# ── Processing mode / remote worker (Vultr VPS) ──────────────────────
# local = run pipeline here; cloud = dispatch to the VPS worker below.
DEFAULT_PROCESSING_MODE=local
# Base URL of the VPS worker (the same backend deployed with IS_WORKER=true).
WORKER_URL=
# Shared secret; set the SAME value on the API host and the worker.
WORKER_API_TOKEN=
# Set true ONLY on the Vultr VPS deployment that runs the heavy pipeline.
IS_WORKER=false

# ── Storage backend ───────────────────────────────────────────────────
# local = serve clips from disk; vultr = upload to Vultr Object Storage.
STORAGE_BACKEND=local
VULTR_S3_ENDPOINT=
VULTR_S3_REGION=us-east-1
VULTR_S3_BUCKET=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
# Optional public/CDN base URL for stored objects.
VULTR_PUBLIC_BASE_URL=

# ── TikTok Content Posting API ────────────────────────────────────────
# From https://developers.tiktok.com/ (Content Posting API product).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/tiktok/auth/callback
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload
